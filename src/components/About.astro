---
import { Image } from "astro:assets";
import backgroundGif from "../assets/hero/background-blue.gif";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "The Bashor Lab (What we do)",
    description = "We use synthetic biology approaches to design, build, and test artificial regulatory programs in human cells. This not only provides insight into the design logic of natural regulation, but also allows us to predictively alter cellular phenotype to create powerful cell-based biotechnologies.",
} = Astro.props;

// Logic to split by full stops and clean up empty strings/whitespace
const sentences = description
    .split('.')
    .map((s) => s.trim())
    .filter((s) => s.length > 0);

const heavyGlow = "text-white leading-tight md:leading-relaxed [text-shadow:0_0_5px_#94e2d5,0_0_10px_rgba(148,226,213,0.8)] md:[text-shadow:0_0_5px_#94e2d5,0_0_10px_#94e2d5,0_0_20px_rgba(148,226,213,0.8),0_0_40px_rgba(148,226,213,0.6),0_0_60px_rgba(148,226,213,0.4)]";
---

<div class="relative w-full min-h-[100svh] flex items-center justify-center p-6 md:p-12 overflow-hidden bg-black font-press-start-2p">
    
    <!-- Background Container -->
    <div class="absolute inset-0 z-0">
        <div class="absolute inset-0 z-10 pointer-events-none bg-[radial-gradient(circle,rgba(0,0,0,0.5)_0%,rgba(0,0,0,0.9)_100%)]"></div>
        
        <Image 
            src={backgroundGif} 
            alt="" 
            fetchpriority="high" 
            class="w-full h-full object-cover [image-rendering:pixelated] opacity-40 md:opacity-50"
        />
    </div>

    <!-- Content -->
    <div class="relative z-20 w-full max-w-[1100px] text-center">
        <h2 class={`${heavyGlow} text-1xl sm:text-3xl md:text-4xl lg:text-4xl mb-8 md:mb-12 tracking-[2px] md:tracking-[4px]`}>
            {title}
        </h2>
        
        <!-- Paragraph Container: adds vertical spacing between the split paragraphs -->
        <div class="flex flex-col space-y-6 md:space-y-10">
            {sentences.map((sentence) => (
                <p class={`${heavyGlow} text-sm sm:text-base md:text-lg lg:text-[1.8rem] max-w-[1000px] mx-auto normal-case text-center`}>
                    {sentence}.
                </p>
            ))}
        </div>
    </div>
</div>