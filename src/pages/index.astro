---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro"; // Import the hero component
import About from "../components/About.astro";
import Research from "../components/Research.astro";
import Publications from "../components/Publications.astro";
import Members from "../components/Members.astro";
import Contact from "../components/Contact.astro";
---

<Layout title="Home | Bashor Lab">
  <section id="home">
    <Hero />
  </section>

  <section id="about">
    <About />
  </section>

  <section id="research">
    <Research />
  </section>

  <section id="publications">
    <Publications />
  </section>
  <section id="members">
    <Members />

    <section id="contact">
      <Contact />
    </section>
  </section>
</Layout>
