---
import { Image } from 'astro:assets';
import contactBg from '../assets/contact/contact-background.gif'; 

interface ContactInfo {
  email: string;
  phone: string;
  address: string;
}

const { 
  title = "CONTACT US",
  email = "caleb.bashor@rice.edu",
  phone = "(713) 348-8231",
  address = "BRC 660C, 6500 Main St., Rice University, Houston, TX 77030"
} = Astro.props;
---

<div class="relative w-full min-h-screen flex items-center justify-center p-6 md:p-12 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <Image 
      src={contactBg} 
      alt="Pixel city background" 
      class="w-full h-full object-cover" 
      quality="high"
    />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <div class="relative z-10 flex flex-col md:flex-row items-center justify-center gap-8 max-w-5xl w-full mx-auto">
    
    <div class="bg-orange-500 border-4 border-black px-8 py-6 shadow-[8px_8px_0px_rgba(0,0,0,1)] text-center w-full md:w-auto transform hover:-translate-y-1 transition-transform">
      <h2 class="text-white text-2xl md:text-3xl tracking-tight leading-relaxed">
        {title}
      </h2>
    </div>

    <div class="bg-[#4D4566]/90 border-4 border-black p-8 md:p-10 shadow-[8px_8px_0px_rgba(0,0,0,1)] w-full max-w-2xl text-[10px] md:text-xs leading-relaxed text-white">
      <p class="mb-6 text-gray-200">
        Interested in joining our group? Get in touch at the addresses below! You can also now keep tabs on our publications, activity, and general scientific musings by visiting our Instagram page.
      </p>

      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-orange-400 font-bold min-w-[80px]">Email:</span>
          <a href={`mailto:${email}`} class="text-white hover:text-orange-300 break-all underline decoration-dotted">
            {email}
          </a>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-orange-400 font-bold min-w-[80px]">Phone:</span>
          <a href={`tel:${phone}`} class="text-white hover:text-orange-300">
            {phone}
          </a>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-start gap-2 pt-4 border-t border-dashed border-gray-500">
          <span class="text-orange-400 font-bold min-w-[80px]">Address:</span>
          <span class="text-gray-300 leading-normal flex-1">
            {address}
          </span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Pixel-art scaling adjustments */
  h2, p, span, a {
    font-family: 'Press Start 2P', monospace;
  }
</style>