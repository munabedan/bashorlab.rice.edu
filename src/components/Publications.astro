---
import { getCollection } from "astro:content";
const pubs = await getCollection("publications");

// Keep these as imports so Astro can process/hash them
import bg_stars from "../assets/publications/Pubs_Background_Houston_BACKGROUND.png";
import bg_city from "../assets/publications/Pubs_Background_Houston_FOREGROUND.png";
import pdf_icon from "../assets/publications/PDF.png";

/** 
 * No more import.meta.glob! 
 * Since the PDFs are in /public/pdfs/, we can reference them 
 * directly by string using the filename from your collection.
 */
---

<div
  class="relative w-full h-screen font-['Press Start_2P',_cursive] selection:bg-white selection:text-black overflow-hidden flex flex-col bg-black"
>
  <!-- BACKGROUND LAYER: Stars -->
  <div class="absolute inset-0 z-0">
    <img
      src={bg_stars.src}
      alt=""
      class="w-full h-full object-cover object-bottom image-rendering:pixelated"
    />
  </div>

  <!-- SCROLLABLE CONTENT LAYER -->
  <main
    class="relative z-10 w-full h-full overflow-y-auto pt-24 pb-[40vh] px-8 md:px-20 flex flex-col items-center custom-scrollbar"
  >
    <div class="w-full max-w-4xl">
      <h1
        class="text-white text-[1.5rem] min-[375px]:text-[1.7rem] sm:text-3xl md:text-4xl mb-12 md:mb-16 tracking-tighter [text-shadow:2px_2px_0_#000] md:[text-shadow:4px_4px_0_#000] text-left w-full uppercase"
      >
        PUBLICATIONS
      </h1>
      <div class="space-y-12">
        {
          pubs.map((pub) => {
            /**
             * Because these files are in 'public/pdfs/', the browser
             * can find them at the root path '/pdfs/'.
             */
            

            return (
              <div class="flex flex-row items-start justify-between group gap-8">
                <div class="text-white text-[10px] md:text-[14px] leading-[1.8] max-w-3xl">
                  <span class="text-gray-300">
                    {pub.data.authors} ({pub.data.year})
                  </span>
                  <span class="block mt-2">
                    {pub.data.title}.
                    <span class="text-white font-bold">{pub.data.journal}</span>.
                  </span>
                </div>

                <div class="flex-shrink-0">
                  <a
                    href={pub.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block transform transition-transform hover:scale-110 active:scale-95 cursor-pointer"
                  >
                    <img
                      src={pdf_icon.src}
                      alt="PDF"
                      class="w-8 md:w-10 h-auto image-rendering:pixelated"
                    />
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="h-64 w-full"></div>
    </div>
  </main>

  <!-- FOREGROUND LAYER: City Buildings -->
  <div class="absolute inset-0 z-20 pointer-events-none">
    <img
      src={bg_city.src}
      alt=""
      class="w-full h-full object-cover object-bottom image-rendering:pixelated"
    />
  </div>
</div>

<style>
  div,
  span,
  p {
    font-smooth: never;
    -webkit-font-smoothing: none;
    text-rendering: pixelated;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 12px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0a0a0a;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #ffffff;
    border: 3px solid #0a0a0a;
  }
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: #ffffff #0a0a0a;
  }
</style>