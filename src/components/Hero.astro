---
import layer1 from "../assets/hero/lab_scene_layer_1.png";
import layer2 from "../assets/hero/lab_scene_layer_2.png";
import layer3 from "../assets/hero/lab_scene_layer_3.png";
import layer4 from "../assets/hero/lab_scene_layer_4.png";
---

<section class="relative bg-transparent" id="parallax-outer">
  <div class="sticky top-20 h-[130vh] w-full overflow-hidden">
    <!-- Parallax Scene -->
    <div class="absolute inset-0 w-full h-full" id="parallax-scene">
      <div class="parallax-layer absolute inset-0 z-10" data-speed="0.1">
        <img src={layer1.src} alt="" class="w-full h-full object-cover" />
      </div>
      <div class="parallax-layer absolute inset-0 z-20" data-speed="0.3">
        <img src={layer2.src} alt="" class="w-full h-full object-cover" />
      </div>
      <div class="parallax-layer absolute inset-0 z-30" data-speed="0.6">
        <img src={layer3.src} alt="" class="w-full h-full object-cover" />
      </div>
      <div class="parallax-layer absolute inset-0 z-100" data-speed="0.9">
        <img src={layer4.src} alt="" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Arrow UI -->
    <div
      id="hero-arrow"
      class="absolute bottom-40 left-1/2 -translate-x-1/2 z-50 animate-bounce text-white"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-16 w-16"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>
  </div>
</section>

<script>
  const outer = document.getElementById("parallax-outer");
  const layers = document.querySelectorAll(
    ".parallax-layer",
  ) as NodeListOf<HTMLElement>;
  const arrow = document.getElementById("hero-arrow");

  let requestPos = 0;
  let currentPos = 0;
  const ease = 0.1;

  function update() {
    if (!outer) return;

    currentPos += (requestPos - currentPos) * ease;

    // Parallax Movement
    layers.forEach((layer) => {
      const speed = parseFloat(layer.getAttribute("data-speed") || "0");
      const yPos = -(currentPos * speed * 0.4);
      layer.style.transform = `translate3d(0, ${yPos}px, 0)`;
    });

    // Arrow Fade
    if (arrow) {
      const rect = outer.getBoundingClientRect();
      if (rect.top === 0) {
        arrow.style.opacity = "1";
      } else {
        const fadeDistance = 200; 
        const arrowOpacity = Math.max(1 - currentPos / fadeDistance, 0);
        arrow.style.opacity = arrowOpacity.toString();
      }
    }

    requestAnimationFrame(update);
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!outer) return;
      const rect = outer.getBoundingClientRect();
      if (rect.top <= 0) {
        requestPos = Math.abs(rect.top);
      }
    },
    { passive: true },
  );

  update();
</script>

<style>
  .parallax-layer {
    will-change: transform;
    image-rendering: pixelated;
  }

  img {
    user-select: none;
    pointer-events: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>