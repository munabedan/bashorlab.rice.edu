---
const researchData = {
  mainTitle: "OUR RESEARCH",
  sections: [
    {
      heading: "Synthetic Regulatory Circuits",
      content:
        "Our work explores the fundamentals of gene expression control in mammalian cells. By leveraging multi-scale regulatory control, we can engineer stable, precise control over complex multi-gene expression programs that can both report on and reprogram cellular function.",
    },
    {
      heading: "Synthetic Signaling Networks",
      content:
        "We engineer protein circuits that sense, compute, and respond to extracellular inputs. These circuits serve as model systems for understanding the molecular and biophysical determinants of signal transduction, and can be used to reshape how a cell interacts with its environment.",
    },
    {
      heading: "Data-driven Genetic Design",
      content:
        "We are creating high-throughput experimental pipelines that enable building and testing of synthetic circuits at an unprecedented scale. The data we generate can be used to train AI algorithms that map genetic design space, dramatically increasing the pace of circuit engineering.",
    },
    {
      heading: "Engineering Cell-Based Therapeutics",
      content:
        "Our ultimate goal is to use our work to create safer, more effective cell-based therapies for indications spanning inflammatory disorders, trauma, and cancer. We work closely with translational and clinical researchers to ensure our designs meet real-world constraints and move efficiently toward therapeutic impact.",
    },
  ],
};
---

<div
  class="relative w-full min-h-[300svh] flex flex-col items-center pt-20 md:pt-32 pb-24 md:pb-48 px-6 md:px-10 box-border overflow-x-hidden"
>
  <div class="relative z-20 w-full max-w-5xl mx-auto">
    <header class="w-full mb-16 md:mb-32 text-center">
      <h1
        class="fade-target opacity-0 translate-y-8 text-white text-xl md:text-4xl tracking-[0.1em] uppercase transform scale-y-110 md:scale-y-120 font-press-start-2p transition-all duration-[2000ms] cubic-bezier(0.25, 1, 0.5, 1) will-change-[opacity,transform]"
      >
        {researchData.mainTitle}
      </h1>
    </header>

    <div class="flex flex-col gap-24 md:gap-40"> 
      {
        researchData.sections.map((item) => (
          /* Changed class to "fade-target" so it shares the same observer script */
          <article class="fade-target opacity-0 translate-y-8 text-center mx-auto max-w-4xl transition-all duration-[600ms] cubic-bezier(0.25, 1, 0.5, 1) will-change-[opacity,transform]">
            <h2 class="text-white text-lg md:text-3xl mb-4 md:mb-8 tracking-[0.1em] transform scale-y-100 origin-center font-press-start-2p">
              {item.heading}
            </h2>

            <p
              class="text-white text-2xl  md:text-4xl  text-center transform scale-y-105 md:scale-y-110 origin-center font-orange-kid"
              set:html={item.content}
            />
          </article>
        ))
      }
    </div>
  </div>
</div>

<style>
  article p :global(strong) {
    color: #fff;
    font-weight: normal;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.6);
  }

  article p {
    word-spacing: 0.1em;
  }
</style>

<script>
  // Now tracks ALL elements with the "fade-target" class (Title + Articles)
  const fadeElements = document.querySelectorAll(".fade-target");

  if (fadeElements.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const ratio = entry.intersectionRatio;
          const target = entry.target as HTMLElement;

          if (ratio > 0.3) {
            // Element is comfortably on screen -> Full opacity
            target.style.opacity = "1";
            target.style.transform = "translateY(0px)";
          } else if (ratio > 0.05) {
            // Element is passing through the fade boundaries -> Transition state
            target.style.opacity = "0.3";
            target.style.transform = "translateY(4px)";
          } else {
            // Element is out of view -> Hidden
            target.style.opacity = "0";
            target.style.transform = "translateY(32px)";
          }
        });
      },
      {
        rootMargin: "-12% 0px -12% 0px",
        threshold: [0, 0.05, 0.15, 0.3, 0.5, 0.7, 1.0]
      }
    );

    fadeElements.forEach((el) => observer.observe(el));
  }
</script>