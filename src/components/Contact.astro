---
import { Image } from "astro:assets";
import contactBg from "../assets/contact/contact-background.gif";

interface ContactInfo {
  email: string;
  phone: string;
  address: string;
}

const {
  title = "CONTACT US",
  email = "caleb.bashor@rice.edu",
  phone = "(713) 348-8231",
  address = "BRC 660C, 6500 Main St., Rice University, Houston, TX 77030",
} = Astro.props;
---

<div
  class="relative w-full min-h-screen flex items-center justify-center p-4 sm:p-6 md:p-12 overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <Image
      src={contactBg}
      alt="Pixel city background"
      class="w-full h-full object-cover"
      quality="high"
    />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <div
    class="relative z-10 flex flex-col items-center justify-center gap-6 max-w-2xl w-full mx-auto px-2 sm:px-0"
  >
    <button
      id="contact-toggle-btn"
      class="bg-orange-500 border-4 border-black px-6 py-4 md:px-8 md:py-6 shadow-[6px_6px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_rgba(0,0,0,1)] text-center w-fit mx-auto transform active:translate-y-1 active:shadow-[2px_2px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all duration-200 cursor-pointer focus:outline-none opacity-0 -translate-x-12"
    >
      <h2 class="text-white text-xl sm:text-2xl md:text-4xl font-press-start-2p pointer-events-none tracking-tight whitespace-nowrap">
        {title}
      </h2>
    </button>

    <div
      id="contact-content-card"
      class="bg-[#4D4566]/90 border-4 border-black shadow-[6px_6px_0px_rgba(0,0,0,1)] md:shadow-[8px_8px_0px_rgba(0,0,0,1)] w-full text-lg sm:text-xl md:text-4xl leading-relaxed text-white font-orange-kid
             opacity-0 max-h-0 overflow-hidden pointer-events-none
             transition-all duration-500 ease-in-out"
    >
      <div class="p-5 sm:p-8 md:p-10">
        <p class="mb-4 sm:mb-6 text-gray-200 text-sm sm:text-base md:text-xl font-sans">
          Interested in joining our group? Get in touch at the addresses below!
          You can also now keep tabs on our publications, activity, and general
          scientific musings by visiting our Instagram page.
        </p>

        <div class="space-y-4 sm:space-y-6 text-base sm:text-lg md:text-2xl">
          <div class="flex flex-col gap-0.5 sm:gap-2">
            <span class="text-orange-400 font-bold sm:min-w-[80px]">Email:</span>
            <a
              href={`mailto:${email}`}
              class="text-white hover:text-orange-300 break-all underline decoration-dotted inline-block"
            >
              {email}
            </a>
          </div>

          <div class="flex flex-col gap-0.5 sm:gap-2">
            <span class="text-orange-400 font-bold sm:min-w-[80px]">Phone:</span>
            <a href={`tel:${phone}`} class="text-white hover:text-orange-300 inline-block">
              {phone}
            </a>
          </div>

          <div
            class="flex flex-col gap-0.5 sm:gap-2 pt-3 border-t border-dashed border-gray-500"
          >
            <span class="text-orange-400 font-bold sm:min-w-[80px]">Address:</span>
            <span class="text-gray-300 leading-normal flex-1 text-sm sm:text-base md:text-xl">
              {address}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes slideInFromLeft {
    0% {
      opacity: 0;
      transform: translateX(-32px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-in {
    animation: slideInFromLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script>
  const toggleBtn = document.getElementById('contact-toggle-btn');
  const contentCard = document.getElementById('contact-content-card');

  if (toggleBtn) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-slide-in');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1
    });

    observer.observe(toggleBtn);
  }

  toggleBtn?.addEventListener('click', () => {
    toggleBtn.classList.toggle('bg-orange-600');
    
    contentCard?.classList.toggle('opacity-0');
    contentCard?.classList.toggle('max-h-0');
    contentCard?.classList.toggle('pointer-events-none');
    
    contentCard?.classList.toggle('opacity-100');
    contentCard?.classList.toggle('max-h-[1200px]'); 
  });
</script>