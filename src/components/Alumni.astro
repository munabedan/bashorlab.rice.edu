---
import { getCollection } from "astro:content";
import bgImage from "../assets/alumni/background-blue.gif";

// Fetch the members from the collection
const members = await getCollection("alumni");
---

<div
    class="min-h-screen w-full py-16 px-6 md:px-12 flex flex-col items-center justify-start bg-cover bg-center"
    style={`background-image: url(${bgImage.src});`}
>
    <h2
        class="text-2xl md:text-4xl text-white mb-16 tracking-wider pixelated-text"
    >
        OUR ALUMNI
    </h2>

    <div class="w-full max-w-5xl flex flex-col gap-12">
        {
            members.map((member) => (
                <div class="flex flex-col md:flex-row items-center justify-between p-6 md:p-8 gap-6">
                    <div class="flex-1 text-center md:text-left">
                        <h3 class="text-lg md:text-xl text-white mb-4 leading-relaxed">
                            {member.data.name}
                        </h3>
                        <p class="text-[1em] md:text-[1em] leading-relaxed max-w-md">
                            {member.data.occupation}
                        </p>
                    </div>

                    <div class="flex-shrink-0">
                        <div class="w-60 h-60 md:w-100 md:h-100 rounded-full overflow-hidden flex items-center justify-center">
                            <img
                                src={member.data.avatar}
                                alt={member.data.name}
                                class="w-full h-full object-cover"
                            />
                        </div>
                    </div>

                    <div class="flex-1 text-center md:text-right">
                        <p class="text-[1em] md:text-[1em] leading-relaxed max-w-md mx-auto md:ml-auto md:mr-0">
                            {member.data.distinction}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</div>

<style>
    .pixelated-text {
        font-family: "Press Start 2P", monospace;
    }
</style>
