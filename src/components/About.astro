---
import { Image } from 'astro:assets';
import backgroundGif from '../assets/hero/background-blue.gif';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "WHAT WE DO:", 
  description = "The goal of our work is to use synthetic regulatory circuits to reprogram the behavior of human cells" 
} = Astro.props;
---

<section class="about-section">
  <div class="bg-container">
    <Image src={backgroundGif} alt="" fetchpriority="high" />
    <!-- Visual reference requested by user -->
    <img src="/image_1bcba1.jpg" alt="" class="reference-layer" />
  </div>
  
  <div class="content-container">
    <h2 class="heavy-glow title">{title}</h2>
    <p class="heavy-glow description">{description}</p>
  </div>
</section>

<style>
  .about-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    background-color: #000;
  }

  .bg-container {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .bg-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    opacity: 0.5;
  }

  /* Hidden layer to keep the image_1bcba1.jpg context if needed for blending */
  .reference-layer {
    display: none;
  }

  .content-container {
    position: relative;
    z-index: 1;
    max-width: 1100px; /* Increased width for larger text */
    text-align: left;
  }

  .heavy-glow {
    color: white;
    text-transform: uppercase;
    /* Layered shadows for "Super Glow" */
    text-shadow: 
      0 0 5px #94e2d5,
      0 0 10px #94e2d5,
      0 0 20px rgba(148, 226, 213, 0.8),
      0 0 40px rgba(148, 226, 213, 0.6),
      0 0 60px rgba(148, 226, 213, 0.4);
    line-height: 1.5;
  }

  .title {
    font-size: 3rem; /* Significant size increase */
    margin-bottom: 2.5rem;
    letter-spacing: 4px;
  }

  .description {
    font-size: 1.8rem; /* Significant size increase */
    max-width: 1000px;
  }

  /* Adjustments for smaller screens to keep the "Large" feel without breaking */
  @media (max-width: 1024px) {
    .title { font-size: 2rem; }
    .description { font-size: 1.2rem; }
  }

  @media (max-width: 640px) {
    .title { font-size: 1.5rem; }
    .description { font-size: 0.9rem; }
  }
</style>