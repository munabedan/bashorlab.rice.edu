---
import { getEntry } from 'astro:content';

// Fetch the entry from your 'research' collection
const researchEntry = await getEntry('research', 'research');

// Fallback to defaults if the data fails to load for any reason
const mainTitle = researchEntry?.data.mainTitle ?? "OUR RESEARCH";
const sections = researchEntry?.data.sections ?? [];
---

<div
  class="relative w-full min-h-[300svh] flex flex-col items-center pt-20 md:pt-32 pb-24 md:pb-48 px-6 md:px-10 box-border overflow-x-hidden"
>
  <div class="relative z-20 w-full max-w-5xl mx-auto">
    <header class="w-full mb-16 md:mb-32 text-center">
      <h1
        class="pointer-events-none translate-y-8 text-white text-xl md:text-4xl tracking-[0.1em] uppercase transform scale-y-110 md:scale-y-120 font-press-start-2p transition-all duration-[2000ms] cubic-bezier(0.25, 1, 0.5, 1) will-change-[opacity,transform]"
      >
        {mainTitle}
      </h1>
    </header>

    <div class="flex flex-col gap-24 md:gap-40"> 
      {
        sections.map((item) => (
          /* Added invisible and pointer-events-none by default */
          <article class="fade-target opacity-0 invisible pointer-events-none translate-y-8 text-center mx-auto max-w-4xl transition-all duration-[400ms] cubic-bezier(0.25, 1, 0.5, 1) will-change-[opacity,transform]">
            <h2 class="text-white text-lg md:text-4xl mb-4 md:mb-8 tracking-[0.1em] transform scale-y-100 origin-center font-press-start-2p">
              {item.heading}
            </h2>

            <p
              class="text-white text-2xl  md:text-3xl  text-center transform scale-y-105 md:scale-y-110 origin-center font-orange-kid"
              set:html={item.content}
            />
          </article>
        ))
      }
    </div>
  </div>
</div>

<style>
  article p :global(strong) {
    color: #fff;
    font-weight: normal;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.6);
  }

  article p {
    word-spacing: 0.1em;
  }
</style>

<script>
  const fadeElements = document.querySelectorAll(".fade-target");

  if (fadeElements.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const ratio = entry.intersectionRatio;
          const target = entry.target as HTMLElement;

          if (ratio > 0.3) {
            // Element is comfortably on screen -> Full opacity & interactive
            target.style.opacity = "1";
            target.style.visibility = "visible";
            target.style.pointerEvents = "auto";
            target.style.transform = "translateY(0px)";
          } else if (ratio > 0.05) {
            // Element is passing through the fade boundaries -> Transition state
            target.style.opacity = "0.3";
            target.style.visibility = "visible";
            target.style.pointerEvents = "auto";
            target.style.transform = "translateY(4px)";
          } else {
            // Element is out of view -> Hidden, un-rendered, and non-interactive
            target.style.opacity = "0";
            target.style.visibility = "hidden";
            target.style.pointerEvents = "none";
            target.style.transform = "translateY(32px)";
          }
        });
      },
      {
        rootMargin: "-12% 0px -12% 0px",
        threshold: [0, 0.05, 0.15, 0.3, 0.5, 0.7, 1.0]
      }
    );

    fadeElements.forEach((el) => observer.observe(el));
  }
</script>